# Development Dockerfile for Rails Interview Challenge
FROM ruby:3.3.5-slim

# Install dependencies
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      curl \
      nodejs \
      npm \
      postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Set work directory
WORKDIR /app

# Install bundler
RUN gem install bundler

# Copy Gemfile and install gems
COPY Gemfile* ./
RUN bundle install

# Copy application code
COPY . .

# Expose port
EXPOSE 3000

# Start command
CMD ["bash"]
