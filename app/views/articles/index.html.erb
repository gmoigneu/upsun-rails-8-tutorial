<div class="container mx-auto px-4 py-8">
  <div class="mb-12">
    <h1 class="text-5xl font-bold text-ctp-text mb-4 bg-gradient-to-r from-ctp-mauve to-ctp-pink bg-clip-text text-transparent">Rails Interview Blog</h1>
    <p class="text-ctp-subtext1 text-lg">A modern blog built with Rails and just the right amount of magic</p>
  </div>

  <div class="flex items-center justify-between mb-8">
    <h2 class="text-3xl font-bold text-ctp-text">Latest Articles</h2>
    <div class="h-px bg-gradient-to-r from-ctp-surface0 to-transparent flex-1 ml-6"></div>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <% @articles.each do |article| %>
      <article class="group bg-ctp-surface0 border border-ctp-surface1 rounded-xl p-6 hover:bg-ctp-surface1 hover:border-ctp-surface2 transition-all duration-300 transform hover:scale-[1.02] hover:shadow-2xl">
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-ctp-text group-hover:text-ctp-mauve transition-colors duration-200">
            <%= link_to article.title, article_path(article), class: "block" %>
          </h3>
          
          <% if article.body.present? %>
            <p class="text-ctp-subtext1 line-clamp-3 leading-relaxed">
              <%= truncate(strip_tags(article.body), length: 120) %>
            </p>
          <% end %>
          
          <div class="flex items-center justify-between pt-4 border-t border-ctp-surface1 group-hover:border-ctp-surface2 transition-colors duration-200">
            <% if article.created_at %>
              <time class="text-sm text-ctp-subtext0 flex items-center">
                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                </svg>
                <%= article.created_at.strftime("%b %d, %Y") %>
              </time>
            <% end %>
            
            <%= link_to article_path(article), class: "inline-flex items-center text-ctp-mauve hover:text-ctp-lavender font-medium transition-colors duration-200" do %>
              Read more
              <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </div>

  <% if @articles.empty? %>
    <div class="text-center py-16">
      <div class="mb-4">
        <svg class="w-16 h-16 mx-auto text-ctp-surface2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-ctp-text mb-2">No articles yet</h3>
      <p class="text-ctp-subtext1 mb-6">Get started by creating your first article.</p>
      <%= link_to "Create Article", new_article_path, class: "inline-flex items-center px-6 py-3 bg-ctp-mauve text-ctp-base font-medium rounded-lg hover:bg-ctp-lavender transition-colors duration-200" %>
    </div>
  <% end %>
</div>
