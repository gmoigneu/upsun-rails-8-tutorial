<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-ctp-text mb-4">Create New Article</h1>
    <p class="text-ctp-subtext1">Share your thoughts with the world</p>
  </div>

  <div class="bg-ctp-surface0 border border-ctp-surface1 rounded-xl p-8">
    <%= form_with model: @article, local: true, class: "space-y-8" do |form| %>
      <% if @article.errors.any? %>
        <div class="bg-ctp-red/10 border border-ctp-red/20 rounded-lg p-4">
          <div class="flex items-start">
            <svg class="w-5 h-5 text-ctp-red mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
            </svg>
            <div>
              <h3 class="text-sm font-medium text-ctp-red mb-2">
                <%= pluralize(@article.errors.count, "error") %> prohibited this article from being saved:
              </h3>
              <ul class="text-sm text-ctp-red space-y-1">
                <% @article.errors.full_messages.each do |message| %>
                  <li>• <%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= form.label :title, "Article Title", class: "block text-sm font-medium text-ctp-text" %>
        <%= form.text_field :title, 
            class: "w-full px-4 py-3 bg-ctp-base border border-ctp-surface2 rounded-lg text-ctp-text placeholder-ctp-subtext0 focus:border-ctp-mauve focus:ring-2 focus:ring-ctp-mauve focus:ring-opacity-20 transition-colors duration-200", 
            placeholder: "Enter a compelling title for your article" %>
      </div>

      <div class="space-y-2">
        <%= form.label :body, "Article Content", class: "block text-sm font-medium text-ctp-text" %>
        <%= form.text_area :body, 
            rows: 12, 
            class: "w-full px-4 py-3 bg-ctp-base border border-ctp-surface2 rounded-lg text-ctp-text placeholder-ctp-subtext0 focus:border-ctp-mauve focus:ring-2 focus:ring-ctp-mauve focus:ring-opacity-20 transition-colors duration-200 resize-vertical", 
            placeholder: "Write your article content here...\n\nTip: You can use line breaks to separate paragraphs." %>
        <p class="text-xs text-ctp-subtext0 mt-1">Share your knowledge, experiences, or insights with the community.</p>
      </div>

      <div class="flex items-center justify-between pt-6 border-t border-ctp-surface1">
        <div class="flex space-x-4">
          <%= form.submit "Create Article", 
              class: "inline-flex items-center px-6 py-3 bg-ctp-mauve text-ctp-base font-medium rounded-lg hover:bg-ctp-lavender focus:outline-none focus:ring-2 focus:ring-ctp-mauve focus:ring-offset-2 focus:ring-offset-ctp-surface0 transition-colors duration-200" %>
          <%= link_to "Save as Draft", "#", 
              class: "inline-flex items-center px-6 py-3 bg-ctp-surface1 text-ctp-text font-medium rounded-lg hover:bg-ctp-surface2 focus:outline-none focus:ring-2 focus:ring-ctp-surface2 focus:ring-offset-2 focus:ring-offset-ctp-surface0 transition-colors duration-200" %>
        </div>
        <%= link_to root_path, class: "inline-flex items-center text-ctp-subtext1 hover:text-ctp-text transition-colors duration-200" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          Cancel
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Writing Tips -->
  <div class="mt-8 bg-ctp-surface0/50 border border-ctp-surface1 rounded-xl p-6">
    <h3 class="text-lg font-semibold text-ctp-text mb-3 flex items-center">
      <svg class="w-5 h-5 mr-2 text-ctp-yellow" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
      </svg>
      Writing Tips
    </h3>
    <ul class="text-sm text-ctp-subtext1 space-y-1">
      <li>• Keep your title clear and descriptive</li>
      <li>• Use paragraphs to break up long sections of text</li>
      <li>• Consider your audience and write in a tone that fits</li>
      <li>• Proofread your content before publishing</li>
    </ul>
  </div>
</div>
