<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-ctp-base text-ctp-text min-h-screen">
    <!-- Navigation -->
    <header class="bg-ctp-mantle border-b border-ctp-surface0 shadow-lg">
      <nav class="container mx-auto px-5 py-4">
        <div class="flex justify-between items-center">
          <div class="flex items-center space-x-8">
            <%= link_to "Rails Blog", root_path, class: "text-xl font-bold text-ctp-text hover:text-ctp-mauve transition-colors duration-200" %>
            <%= link_to "All Articles", root_path, class: "text-ctp-subtext1 hover:text-ctp-text transition-colors duration-200" %>
          </div>
          <div>
            <%= link_to "New Article", new_article_path, class: "bg-ctp-mauve text-ctp-base px-4 py-2 rounded-lg hover:bg-ctp-lavender transition-colors duration-200 font-medium" %>
          </div>
        </div>
      </nav>
    </header>

    <!-- Flash Messages -->
    <% if flash.any? %>
      <div class="container mx-auto px-5 mt-4">
        <% flash.each do |type, message| %>
          <% css_class = case type.to_sym
                         when :notice
                           "bg-ctp-green/10 border border-ctp-green/20 text-ctp-green"
                         when :alert, :error
                           "bg-ctp-red/10 border border-ctp-red/20 text-ctp-red"
                         when :warning
                           "bg-ctp-yellow/10 border border-ctp-yellow/20 text-ctp-yellow"
                         else
                           "bg-ctp-blue/10 border border-ctp-blue/20 text-ctp-blue"
                         end %>
          <div class="<%= css_class %> rounded-lg p-4 mb-4 flex items-start fade-in" role="alert">
            <div class="flex-shrink-0 mr-3">
              <% if type.to_sym == :notice %>
                <svg class="w-5 h-5 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              <% elsif type.to_sym.in?([:alert, :error]) %>
                <svg class="w-5 h-5 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
              <% elsif type.to_sym == :warning %>
                <svg class="w-5 h-5 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                </svg>
              <% else %>
                <svg class="w-5 h-5 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                </svg>
              <% end %>
            </div>
            <div class="flex-1">
              <p class="font-medium"><%= message %></p>
            </div>
            <button class="flex-shrink-0 ml-4 text-current opacity-70 hover:opacity-100 transition-opacity duration-200" onclick="this.parentElement.style.display='none'">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="container mx-auto mt-8 px-5 flex min-h-screen">
      <%= yield %>
    </main>
  </body>
</html>
